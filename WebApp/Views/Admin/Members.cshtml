@using WebApp.ViewModels
@model MembersViewModel

@{
	ViewData["Title"] = "Team Members";
}



@await Html.PartialAsync("Partials/Components/Sections/_AddMemberForm", Model.AddForm)
@await Html.PartialAsync("Partials/Components/Sections/_EditMemberForm", Model.EditForm)

<section>

	<div class="page-header">
		<h1>@ViewData["Title"]</h1>
		<button type="button" data-modal="true" data-target="#addMemberModal" class="btn btn-add btn-blue">Add Member</button>
	</div>

	<div class="members-list">

		@if (Model != null)
		{
			@foreach (var member in Model.Members)
			{
				<div class="card member">
					<h4 class="name">@member.FirstName @member.LastName</h4>
					<div class="jobtitle">@member.JobTitle</div>
					<div class="email">@member.Email</div>
					<div class="phone">@member.Phone</div>
					<div class="role"></div>
				</div>
			}
		}

	</div>
</section>



