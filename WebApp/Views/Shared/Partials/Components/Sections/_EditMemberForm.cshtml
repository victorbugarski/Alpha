@model EditMemberForm

<div id="editMemberModal" class="modal">
	<div class="modal-content">
		<div class="modal-header">
			<h3>Edit Member</h3>
			<button type="button" class="btn-close" data-close="true"></button>
		</div>

		<form novalidate method="post" asp-action="Edit" asp-controller="Members">
			<input asp-for="Id" readonly type="hidden" />

			<div class="image-previewer circle">
				<img src="" class="image-preview" />
				<input asp-for="MemberImage" accept="image/*" class="hide" />
			</div>

			<div class="form-group">
				<label asp-for="MemberName"></label>
				<div class="field-group">
					<input asp-for="MemberName" />
					<span asp-validation-for="MemberName"></span>
				</div>
			</div>

			<div class="form-group">
				<label asp-for="Role"></label>
				<div class="field-group">
					<input asp-for="Role" />
					<span asp-validation-for="Role"></span>
				</div>
			</div>

			<div class="form-group">
				<label asp-for="Email"></label>
				<div class="field-group">
					<input asp-for="Email" />
					<span asp-validation-for="Email"></span>
				</div>
			</div>

			<div class="form-group">
				<label asp-for="Phone"></label>
				<div class="field-group">
					<input asp-for="Phone" />
					<span asp-validation-for="Phone"></span>
				</div>
			</div>

			<button type="submit" class="btn btn-submit btn-blue">Save</button>
		</form>

	</div>
</div>

